# AquaVision AI - Environment Configuration
# Copy to .env and configure

# === Database ===
DATABASE_URL=sqlite:///./aquavision.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost:5432/aquavision

# === API ===
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# === Authentication ===
JWT_SECRET_KEY=change-this-to-a-strong-random-secret-key-minimum-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080

# === Storage ===
STORAGE_ROOT=./storage
ORIGINALS_DIR=./storage/originals
PROCESSED_DIR=./storage/processed
EVIDENCE_DIR=./storage/evidence
REPORTS_DIR=./storage/reports

# === ML/AI ===
ML_MODELS_DIR=./ml/models
ML_DEVICE=cpu
ML_BATCH_SIZE=16
DETECTION_CONFIDENCE_THRESHOLD=0.25
ANOMALY_THRESHOLD=0.5
TILE_SIZE=512
TILE_OVERLAP=64

# === Processing ===
MAX_CONCURRENT_JOBS=2
MAX_UPLOAD_SIZE_MB=500

# === Frontend ===
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=AquaVision AI
NEXT_PUBLIC_APP_SUBTITLE=AI-Powered Underwater Marine Debris & Anomaly Detection Platform
